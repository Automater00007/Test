# ---------------------------------------------------------------------------
# Sanity CMS
# ---------------------------------------------------------------------------
# Project ID from sanity.io/manage → your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Server-only token. "Viewer" is enough to read published content.
# Use an "Editor" token if you want to preview drafts.
SANITY_API_TOKEN=

# Optional: a separate token used only to create review submissions.
# Falls back to SANITY_API_TOKEN, which needs Editor/Developer permission.
SANITY_WRITE_TOKEN=

# Public site URL used by the QR generator (npm run review-qr).
# Point this at the final production domain before printing the QR code.
NEXT_PUBLIC_SITE_URL=

# Optional: protects /api/draft and /api/revalidate.
SANITY_PREVIEW_SECRET=
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Google reviews (Places API — New)
# ---------------------------------------------------------------------------
# Server-side key, restricted to "Places API (New)". Never expose it with
# NEXT_PUBLIC_. Leave these empty to fall back to the curated reviews.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
