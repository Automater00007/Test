# ---------------------------------------------------------------------------
# Sanity CMS
# ---------------------------------------------------------------------------
# Project ID from sanity.io/manage → your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Server-only token. "Viewer" is enough to read published content.
# Use an "Editor" token if you want to preview drafts.
SANITY_API_TOKEN=

# Optional: protects /api/draft and /api/revalidate.
SANITY_PREVIEW_SECRET=
SANITY_REVALIDATE_SECRET=
